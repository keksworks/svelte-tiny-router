{
  "name": "@keksworks/svelte-tiny-router",
  "version": "0.1.0",
  "description": "A tiny, lightweight router for Svelte applications",
  "type": "module",
  "module": "src/lib/index.ts",
  "main": "src/lib/index.ts",
  "svelte": "src/lib/index.ts",
  "types": "src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    }
  },
  "files": [
    "src/lib",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "svelte",
    "router",
    "svelte-router",
    "tiny-router"
  ],
  "author": "Anton Keks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keksworks/svelte-tiny-router.git"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^24.0.0",
    "jsdom": "^27.4.0",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
